# ClaimGraph environment template
# Copy these values into a local .env file and replace placeholders with your real keys.

# Core services
MONGO_URI=mongodb://localhost:27017/claimgraph
QDRANT_URL=http://localhost:6333
GROBID_URL=http://localhost:8070
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# External APIs
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
OPENALEX_EMAIL=your_email_here

# Ollama configuration
OLLAMA_BASE_URL=https://your-ollama-cloud-url
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_TIMEOUT=60.0
